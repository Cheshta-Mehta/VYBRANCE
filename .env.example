# Copy to .env (never commit .env). Generate API_KEY: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=
PORT=8787
# Your page's origin, e.g. https://yourname.github.io  (use * only for local testing)
ALLOWED_ORIGIN=*
# mock = logs only, sends nothing. twilio = real SMS.
PROVIDER=mock
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_TO=+91XXXXXXXXXX
MAX_PER_HOUR=10
COOLDOWN_SEC=300
